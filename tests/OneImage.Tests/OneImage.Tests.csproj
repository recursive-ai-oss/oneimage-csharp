<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>$(LibName).Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- Tests deliberately call blocking and token-defaulted APIs of the library under test. -->
    <NoWarn>$(NoWarn);xUnit1051;xUnit1031</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="System" />
    <Using Include="System.Collections.Generic" />
    <Using Include="System.IO" />
    <Using Include="System.Linq" />
    <Using Include="System.Threading" />
    <Using Include="System.Threading.Tasks" />
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <!-- Reference implementations for the compression tests only; the library depends on nothing. -->
    <PackageReference Include="Magick.NET-Q8-AnyCPU" VersionOverride="15.0.0" />
    <PackageReference Include="System.IO.Hashing" VersionOverride="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="../testdata/**" Link="testdata/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/OneImage/OneImage.csproj" />
  </ItemGroup>

</Project>
