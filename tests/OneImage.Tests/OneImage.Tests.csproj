<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>$(LibName).Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <!-- Competitor packages are pinned for comparison only; their security advisories do not affect what ships. -->
    <NoWarn>$(NoWarn);NU1901;NU1902;NU1903;NU1904</NoWarn>
    <IsTestProject>true</IsTestProject>
    <!-- Tests deliberately call blocking and token-defaulted APIs of the library under test. -->
    <NoWarn>$(NoWarn);xUnit1051;xUnit1031</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="System" />
    <Using Include="System.Collections.Generic" />
    <Using Include="System.IO" />
    <Using Include="System.Linq" />
    <Using Include="System.Threading" />
    <Using Include="System.Threading.Tasks" />
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <!-- Reference implementations for the compression tests only; the library depends on nothing. -->
    <PackageReference Include="Magick.NET-Q8-AnyCPU" />
    <PackageReference Include="System.IO.Hashing" />
    <!-- libvips as an independent reference for the geometry and tone ops. -->
    <PackageReference Include="NetVips" />
    <PackageReference Include="NetVips.Native" />
    <!-- libjpeg-turbo behind SkiaSharp is the JPEG oracle for the interoperability tests. -->
    <PackageReference Include="SkiaSharp" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" />
    <!-- ImageSharp is a second oracle for the tone operations. -->
    <PackageReference Include="SixLabors.ImageSharp" />
    <PackageReference Include="SixLabors.ImageSharp.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="../../bench/OneImage.Benchmarks/Gif/GifBenchData.cs" Link="Gif/GifBenchData.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- Lets the documentation checks find the Markdown files without relying on source paths. -->
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>RepoRoot</_Parameter1>
      <_Parameter2>$(MSBuildThisFileDirectory)../../</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <Content Include="../testdata/**" Link="testdata/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../testdata/jpx/**" Link="testdata/jpx/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../data/FOGRA39.txt" Link="testdata/FOGRA39.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/OneImage/OneImage.csproj" />
  </ItemGroup>

</Project>
