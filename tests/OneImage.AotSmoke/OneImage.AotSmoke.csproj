<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>$(LibName).AotSmoke</RootNamespace>
    <IsPackable>false</IsPackable>
    <PublishAot>true</PublishAot>
    <IsAotCompatible>true</IsAotCompatible>
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/OneImage/OneImage.csproj" />
    <ProjectReference Include="../../src/OneImage.Text/OneImage.Text.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The text smoke loads these next to the executable. -->
    <Content Include="../testdata/fonts/*.ttf;../testdata/fonts/*.otf;../testdata/fonts/*.ttc;../testdata/fonts/*.woff;../testdata/fonts/*.woff2" Link="fonts/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
