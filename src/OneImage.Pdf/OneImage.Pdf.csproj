<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>$(LibName).Pdf</AssemblyName>
    <RootNamespace>$(LibName).Pdf</RootNamespace>
    <PackageId>$(PackagePrefix)$(LibName).Pdf</PackageId>
    <Description>PDF support for OneImage: renders PDF pages as an image format, drawn on demand per tile from OnePDF display lists.</Description>
    <IsAotCompatible>true</IsAotCompatible>
    <IsTrimmable>true</IsTrimmable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>image;imaging;pdf;render;rasterize;nativeaot;trimmable</PackageTags>
    <PackageReleaseNotes>See CHANGELOG.md in the repository.</PackageReleaseNotes>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="System" />
    <Using Include="System.Collections.Generic" />
    <Using Include="System.IO" />
    <Using Include="System.Linq" />
    <Using Include="System.Threading" />
    <Using Include="System.Threading.Tasks" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../OneImage/OneImage.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="RecursiveAI.OnePdf" />
    <PackageReference Include="RecursiveAI.OnePdf.Fonts" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="$(LibName).Pdf.Tests" />
    <InternalsVisibleTo Include="$(LibName).Fuzz" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <!-- The package uses internals of the projects it references (InternalsVisibleTo), so it only works with the exact version it was built
       against: the packed dependencies are [version], not the default "version or later". -->
  <Target Name="RequireExactProjectReferenceVersions" AfterTargets="_GetProjectReferenceVersions">
    <ItemGroup>
      <_ProjectReferencesWithVersions Update="@(_ProjectReferencesWithVersions)">
        <ProjectVersion>[%(ProjectVersion)]</ProjectVersion>
      </_ProjectReferencesWithVersions>
    </ItemGroup>
  </Target>

</Project>
