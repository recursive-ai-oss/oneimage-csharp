<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>$(LibName)</AssemblyName>
    <RootNamespace>$(LibName)</RootNamespace>
    <PackageId>$(PackagePrefix)$(LibName)</PackageId>
    <Description>A pure-managed .NET image library: one-line thumbnails, crops and conversions, and lazy, tiled, streaming load, edit and render on the same engine.</Description>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsAotCompatible>true</IsAotCompatible>
    <IsTrimmable>true</IsTrimmable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>image;imaging;thumbnail;resize;jpeg;png;webp;gif;tiff;bmp;icc;color-management;nativeaot;trimmable</PackageTags>
    <PackageReleaseNotes>See CHANGELOG.md in the repository.</PackageReleaseNotes>
    <!-- Symbols ship as a separate .snupkg. SourceLink for GitHub comes with the SDK; embedding untracked sources and
         the commit in the repository metadata makes the debug experience work without any package reference. -->
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="System" />
    <Using Include="System.Collections.Generic" />
    <Using Include="System.IO" />
    <Using Include="System.Linq" />
    <Using Include="System.Threading" />
    <Using Include="System.Threading.Tasks" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Color/Data/generic-cmyk.bin" LogicalName="generic-cmyk.bin" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="$(LibName).Tests" />
    <InternalsVisibleTo Include="$(LibName).Benchmarks" />
    <InternalsVisibleTo Include="$(LibName).AotSmoke" />
    <InternalsVisibleTo Include="$(LibName).Svg" />
    <InternalsVisibleTo Include="$(LibName).Tools" />
    <InternalsVisibleTo Include="$(LibName).JpegHash" />
    <InternalsVisibleTo Include="$(LibName).Fuzz" />
    <InternalsVisibleTo Include="$(LibName).Text" />
    <InternalsVisibleTo Include="$(LibName).Psd" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

</Project>
