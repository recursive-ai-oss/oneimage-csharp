<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <!--
    ImageSharp 4.x checks for a Six Labors license key at build time, in every project that references it directly.
    Without a key the comparisons use 3.1.12, the last release without that check. Supplying the key, as the
    SixLaborsLicenseKey property or environment variable, switches to the current release with no other change.
    ImageSharpVersion can also be set explicitly, for example to compile-check against 4.x in Debug builds.
  -->
  <PropertyGroup>
    <ImageSharpVersion Condition="'$(ImageSharpVersion)' == '' and '$(SixLaborsLicenseKey)' != ''">4.1.3</ImageSharpVersion>
    <ImageSharpVersion Condition="'$(ImageSharpVersion)' == ''">3.1.12</ImageSharpVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="xunit.v3" Version="4.0.2" />
    <PackageVersion Include="BenchmarkDotNet" Version="0.15.8" />
    <!-- Reference and competitor libraries, used only by the tests and benchmarks. The library itself depends on nothing. -->
    <PackageVersion Include="System.IO.Hashing" Version="10.0.0" />
    <PackageVersion Include="Magick.NET-Q8-AnyCPU" Version="15.0.0" />
    <PackageVersion Include="SkiaSharp" Version="4.153.1" />
    <PackageVersion Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="4.153.1" />
    <PackageVersion Include="NetVips" Version="3.2.0" />
    <PackageVersion Include="NetVips.Native.linux-x64" Version="8.18.7" />
    <PackageVersion Include="SixLabors.ImageSharp" Version="$(ImageSharpVersion)" />
  </ItemGroup>
</Project>
