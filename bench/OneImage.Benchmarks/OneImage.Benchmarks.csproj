<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>$(LibName).Benchmarks</RootNamespace>
    <IsPackable>false</IsPackable>
    <!-- Competitor packages are pinned for comparison only; their security advisories do not affect what ships. -->
    <NoWarn>$(NoWarn);NU1901;NU1902;NU1903;NU1904</NoWarn>
    <!-- BenchmarkDotNet is not trim/AOT clean and the host runs it as plain managed code. -->
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="System" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" />
    <PackageReference Include="System.IO.Hashing" />
    <PackageReference Include="SixLabors.ImageSharp" />
    <PackageReference Include="SkiaSharp" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" />
    <PackageReference Include="NetVips" />
    <PackageReference Include="NetVips.Native.linux-x64" />
    <PackageReference Include="Magick.NET-Q8-AnyCPU" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/OneImage/OneImage.csproj" />
  </ItemGroup>

</Project>
