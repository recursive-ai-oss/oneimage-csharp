<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>$(LibName).Benchmarks</RootNamespace>
    <IsPackable>false</IsPackable>
    <!-- Competitor packages are pinned for comparison only; their security advisories do not affect what ships. -->
    <NoWarn>$(NoWarn);NU1901;NU1902;NU1903;NU1904</NoWarn>
    <!-- BenchmarkDotNet is not trim/AOT clean and the host runs it as plain managed code. -->
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="System" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" />
    <PackageReference Include="System.IO.Hashing" />
    <PackageReference Include="SixLabors.ImageSharp" />
    <PackageReference Include="SixLabors.ImageSharp.Drawing" />
    <PackageReference Include="SkiaSharp" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" />
    <PackageReference Include="Svg.Skia" />
    <PackageReference Include="NetVips" />
    <PackageReference Include="NetVips.Native" />
    <PackageReference Include="Magick.NET-Q8-AnyCPU" />
  </ItemGroup>

  <ItemGroup>
    <!-- The benchmark child process runs from another directory; this lets it find the repository's test fonts. -->
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>RepoRoot</_Parameter1>
      <_Parameter2>$(MSBuildThisFileDirectory)../../</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/OneImage/OneImage.csproj" />
    <ProjectReference Include="../../src/OneImage.Text/OneImage.Text.csproj" />
    <ProjectReference Include="../../src/OneImage.Svg/OneImage.Svg.csproj" />
    <ProjectReference Include="../../src/OneImage.Psd/OneImage.Psd.csproj" />
    <ProjectReference Include="../../src/OneImage.Pdf/OneImage.Pdf.csproj" />
  </ItemGroup>

</Project>
