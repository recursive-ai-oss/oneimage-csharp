<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>$(LibName).Web.Benchmarks</RootNamespace>
    <IsPackable>false</IsPackable>
    <!-- Competitor packages are pinned for comparison only; their security advisories do not affect what ships. -->
    <NoWarn>$(NoWarn);NU1901;NU1902;NU1903;NU1904;CA1812</NoWarn>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="System" />
    <Using Include="System.IO" />
    <Using Include="System.Net.Http" />
    <Using Include="System.Threading" />
    <Using Include="System.Threading.Tasks" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" />
    <PackageReference Include="SixLabors.ImageSharp" />
    <PackageReference Include="SixLabors.ImageSharp.Web" />
    <PackageReference Include="Microsoft.AspNetCore.TestHost" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <ProjectReference Include="../../src/OneImage.Web/OneImage.Web.csproj" />
  </ItemGroup>

</Project>
